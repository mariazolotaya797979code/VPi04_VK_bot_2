# Ключ сообщества: Управление → Дополнительно → Работа с API → Создать ключ
VK_TOKEN=YOUR_VK_COMMUNITY_TOKEN
VK_GROUP_ID=241359266
VK_API_VERSION=5.199

# Название студии в приветствии
STUDIO_NAME=Детейлинг-студия

# Контакт менеджера (необязательно). Можно указать одно или оба поля.
# Ссылка на диалог / страницу, например https://vk.com/write123456
MANAGER_URL=
# Числовой id пользователя ВК, например 123456789
MANAGER_ID=
